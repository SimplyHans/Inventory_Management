@inject SignInManager<IdentityUser> SignInManager
<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Assignment1</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-start w-100">
            <ul class="navbar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="ProjectManagement" asp-controller="Product" asp-action="Index">Management</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="ProjectManagement" asp-controller="Order" asp-action="Cart">Cart</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="ProjectManagement" asp-controller="Order" asp-action="Track">Orders</a>
                </li>
            </ul>
        </div>
        
        @*RIGHT SIDE*@
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
            <ul class="navbar-nav flex-grow-1 ms-auto">
                @if (SignInManager.IsSignedIn(User))
                {
                    //Ability to update account
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-area="Identity"
                           asp-page="/Account/Manage/Index"
                           title="Manage Your Profile">
                            <i class="fa-solid fa-user-settings"></i> Profile
                        </a>
                    </li>

                    //Ability to logout
                    <li class="nav-item">
                        <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                            <button type="submit" class="nav-link btn btn-link text-dark" style="cursor: pointer">Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    //Non login users will only be able to see the login button
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-area="Identity"
                           asp-page="/Account/Login">Login
                        </a>
                    </li>

                    //Non login users will also only be able to see the register button
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-area="Identity"
                           asp-page="/Account/Register">Register
                        </a>
                    </li>
                }
                
            </ul>
        </div>

    </div>
</nav>