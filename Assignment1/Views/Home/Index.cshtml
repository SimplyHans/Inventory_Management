@model Assignment1.Areas.ProjectManagement.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
}

<style>
    .center-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    .home-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
    }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin: 0 2.5rem 0 2.5rem;
    }

    .filter-row .form-group {
        flex: 1;
        min-width: 200px;
    }

    .form-control {
        border-radius: 0.75rem;
    }
    

    /* Circular checkbox */
    .form-check-input {
        border-radius: 50% !important;
        width: 2.25rem;
        height: 2.25rem;
        margin-top: 0.15rem; /* adjust vertical alignment */
        margin-right: 0.5rem;
        border: 1px solid #ccc;
    }
    

    #loadingScreen {
        margin: 2rem 0;
    }
</style>

<div class="center-wrapper">
    <div class="home-container">

        <!-- Filters Section -->
        <form method="get" asp-action="Index" class="filter-row">
            <!-- Search -->
            <div class="form-group">
                <label for="searchQuery">Search:</label>
                <input type="text" class="form-control" id="searchQuery" name="searchQuery" placeholder="Search Product..." value="@Context.Request.Query["searchQuery"]">
            </div>

            <!-- Category -->
            <div class="form-group">
                <label for="category">Category:</label>
                <select class="form-control" id="category" name="category">
                    <option value="">All Categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Name" selected="@(Context.Request.Query["category"] == category.Name ? "selected" : null)">
                            @category.Name
                        </option>
                    }
                </select>
            </div>

            <!-- Sort By -->
            <div class="form-group">
                <label for="sortBy">Sort By:</label>
                <select class="form-control" id="sortBy" name="sortBy">
                    <option value="">Default</option>
                    <option value="name_asc" selected="@(Context.Request.Query["sortBy"] == "name_asc" ? "selected" : null)">Name (A-Z)</option>
                    <option value="name_desc" selected="@(Context.Request.Query["sortBy"] == "name_desc" ? "selected" : null)">Name (Z-A)</option>
                    <option value="price_asc" selected="@(Context.Request.Query["sortBy"] == "price_asc" ? "selected" : null)">Price (Low to High)</option>
                    <option value="price_desc" selected="@(Context.Request.Query["sortBy"] == "price_desc" ? "selected" : null)">Price (High to Low)</option>
                </select>
            </div>

            <!-- Low Stock Filter -->
            <div class="form-group d-flex align-items-end">
                <label class="d-flex align-items-center">
                    <input class="form-check-input" type="checkbox" id="lowStockFilter" name="lowStockFilter" value="true"
                           @(Context.Request.Query["lowStockFilter"] == "true" ? "checked" : "")>
                    <span class="ml-2">Low Stock Only</span>
                </label>
            </div>

        </form>

        <!-- Error Message -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Products Table -->
        <div id="loadingScreen" style="display:none; text-align: center;">
            <div class="spinner-border text-primary" role="status"></div>
        </div>

        <div id="productContainer" class="row row-cols-2 row-cols-md-3 row-cols-lg-5 gy-2">
            @await Html.PartialAsync("_HomeItems", Model)
        </div>
        

    </div>
</div>

@section Scripts {
    <script>
        // Function to load products via AJAX
        function loadProducts() {
            // Show the loading spinner when AJAX request starts
            $("#loadingScreen").show();

            // Hide the product table while loading
            $("#productTable").hide();

            let query = $("#searchQuery").val();
            let category = $("#category").val();
            let sortBy = $("#sortBy").val();
            let lowStockFilter = $("#lowStockFilter").is(":checked");

            // Perform the AJAX request
            $.ajax({
                url: '@Url.Action("Search", "Home")',
                data: {
                    searchQuery: query,
                    category: category,
                    sortBy: sortBy,
                    lowStockFilter: lowStockFilter
                },
                type: "GET", // Ensure the request is GET
                success: function (result) {
                    // Introduce a delay (e.g., 1 second) before hiding the loading screen and showing the data
                    setTimeout(function() {
                        // Hide the loading spinner after the data is loaded
                        $("#loadingScreen").hide();

                        // Update the product table with the new data
                        $("#productContainer").html(result);

                        // Show the table once the data has been updated
                        $("#productContainer").show();
                    }, 200);  // 1000 milliseconds = 1 second delay
                },
                error: function () {
                    // Hide the loading spinner if there's an error
                    $("#loadingScreen").hide();
                    alert("An error occurred while loading the data.");
                }
            });
        }

        // Trigger the loadProducts function only when the search query or filters change
        $(document).ready(function () {
            // Trigger AJAX when any search/filter input changes
            $("#searchQuery, #category, #sortBy, #lowStockFilter").on("change keyup", function () {
                loadProducts();
            });

            // Optional: Trigger search when pressing "Enter" in the search box
            $("#searchQuery").on("keypress", function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    loadProducts();
                }
            });
        });
    </script>
}