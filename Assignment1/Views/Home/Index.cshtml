@model Assignment1.Areas.ProjectManagement.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
}

<h2>Welcome to Our Store</h2>

<!-- Filters Section -->
<div class="container mb-4">
    <form method="get" asp-action="Index" class="form-inline">
        <!-- Search by Name -->
        <div class="form-group mr-3">
            <label for="searchQuery" class="mr-2">Search:</label>
            <input type="text" class="form-control" id="searchQuery" name="searchQuery" placeholder="Product name..." value="@Context.Request.Query["searchQuery"]">
        </div>

        <!-- Category Dropdown -->
        <div class="form-group mr-3">
            <label for="category" class="mr-2">Category:</label>
            <select class="form-control" id="category" name="category">
                <option value="">All Categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Name" selected="@(Context.Request.Query["category"] == category.Name ? "selected" : null)">@category.Name</option>
                }
            </select>
        </div>

        <!-- Sort By Dropdown -->
        <div class="form-group mr-3">
            <label for="sortBy" class="mr-2">Sort By:</label>
            <select class="form-control" id="sortBy" name="sortBy">
                <option value="">Default</option>
                <option value="name_asc" selected="@(Context.Request.Query["sortBy"] == "name_asc" ? "selected" : null)">Name (A-Z)</option>
                <option value="name_desc" selected="@(Context.Request.Query["sortBy"] == "name_desc" ? "selected" : null)">Name (Z-A)</option>
                <option value="price_asc" selected="@(Context.Request.Query["sortBy"] == "price_asc" ? "selected" : null)">Price (Low to High)</option>
                <option value="price_desc" selected="@(Context.Request.Query["sortBy"] == "price_desc" ? "selected" : null)">Price (High to Low)</option>
            </select>
        </div>

        <!-- Low Stock Checkbox -->
        <div class="form-group mr-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="lowStockFilter" name="lowStockFilter" value="true" @(Context.Request.Query["lowStockFilter"] == "true" ? "checked" : "")>
                <label class="form-check-label" for="lowStockFilter">Show Low Stock Only</label>
            </div>
        </div>

        <!-- Apply Filters Button -->
        <button type="submit" class="btn btn-primary">Apply Filters</button>
        <a asp-action="Index" class="btn btn-secondary ml-2">Clear Filters</a>
    </form>
</div>

<!-- Product Table -->
<div class="container">
    <h3>Featured Products</h3>
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="thead-dark">
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Stock Status</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Products != null && Model.Products.Any())
            {
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.Category</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>@product.Quantity</td>
                        <td>
                            @if (product.Quantity < product.LowStockThreshold)
                            {
                                <span class="badge" style="background-color: #dc3545; color: white;">Low Stock</span>
                            }
                            else
                            {
                                <span class="badge" style="background-color: #28a745; color: white;">In Stock</span>
                            }
                        </td>
                        <td>
                            <form asp-area="ProjectManagement" asp-controller="Order" asp-action="AddToCart" method="post">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <input type="number" name="quantity" value="1" min="1" max="@product.Quantity" class="form-control d-inline-block w-auto mr-2" />
                                <button type="submit" class="btn btn-success">Add to Cart</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No products available.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Error Message Display -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}