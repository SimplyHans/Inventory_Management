@model Assignment1.Areas.ProjectManagement.Models.HomeIndexViewModel

@if (Model.Products != null && Model.Products.Any())
{
    
    @foreach (var product in Model.Products)
    {
        <div class="card-body">
            <div class="h-100 p-2" style="width: 100%; min-width: 170px; max-width: 220px;">

                <div class="position-relative w-100" style="padding-top: 100%; border-radius: 10px; overflow: hidden; background-color: #f4f4f4;">
                    <img src="" onerror="this.style.display='none'" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover" style="border-radius: 10px; overflow: hidden; border: none; box-shadow: none;" />
                </div>


                <h2 style="margin: 0; padding-top: 3px; font-size: 20px;">@product.Name</h2>
                <p style="margin: 0; color: #575757;">@product.Category • @product.Quantity
                    @if (product.Quantity < product.LowStockThreshold)
                    {
                        <span class="badge" style="background-color: rgba(232,47,96,0.84); color: white; border-radius: 50px">Low Stock</span>
                    }
                    else
                    {
                        <span class="badge" style="background-color: #01e18e; color: white; border-radius: 50px;">In Stock</span>
                    }
                </p>



                <h3 style="padding-top: 5px; padding-bottom: 2px;">$@product.Price</h3>



                <form asp-area="ProjectManagement" asp-controller="Order" asp-action="AddToCart" method="post" class="align-items-center justify-content-center d-flex gap-2" style="padding: 0;">
                    <input type="hidden" name="productId" value="@product.Id"/>
                    <input type="number" name="quantity" value="1" min="1" max="@product.Quantity" class="form-control" style="width: 60px; border-radius: 50px;"/>
                    <button type="submit" class="btn" style="border-radius: 50px; padding-left: 32px; padding-right: 32px; background-color: #01e18e; color: white; font-weight: bolder;"><i class="fa-solid fa-plus"></i> Cart</button>
                </form>
            </div>
        </div>

        
        @* <tr> *@
        @*     <td>@product.Name</td> *@
        @*     <td>@product.Category</td> *@
        @*     <td>@product.Price.ToString("C")</td> *@
        @*     <td>@product.Quantity</td> *@
        @*     <td> *@
        @*         @if (product.Quantity < product.LowStockThreshold) *@
        @*         { *@
        @*             <span class="badge" style="background-color: #dc3545; color: white;">Low Stock</span> *@
        @*         } *@
        @*         else *@
        @*         { *@
        @*             <span class="badge" style="background-color: #28a745; color: white;">In Stock</span> *@
        @*         } *@
        @*     </td> *@
        @*     <td> *@
        @*         <form asp-area="ProjectManagement" asp-controller="Order" asp-action="AddToCart" method="post"> *@
        @*             <input type="hidden" name="productId" value="@product.Id" /> *@
        @*             <input type="number" name="quantity" value="1" min="1" max="@product.Quantity" class="form-control d-inline-block w-auto mr-2" /> *@
        @*             <button type="submit" class="btn btn-success">Add to Cart</button> *@
        @*         </form> *@
        @*     </td> *@
        @* </tr> *@
    }
}
else
{
    <tr>
        <td colspan="6" class="text-center">No products available.</td>
    </tr>
}
