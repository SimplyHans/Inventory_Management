@model IEnumerable<Assignment1.Models.Product>

@{
    ViewData["Title"] = "Inventory Management";
}

<h2>@ViewData["Title"]</h2>

<!-- Add New Product Button -->
<a asp-action="Create" class="btn btn-success mb-3">Create Product</a>

<a asp-controller="Category" asp-action="Index" class="btn btn-success mb-3">Add New Category</a>

<!-- Filters Section -->
<div class="container mb-4">
    <form method="get" asp-action="Index" class="form-inline">
        <!-- Search by Name -->
        <div class="form-group mr-3">
            <label for="searchQuery" class="mr-2">Search:</label>
            <input type="text" class="form-control" id="searchQuery" name="searchQuery" placeholder="Product name..." value="@Context.Request.Query["searchQuery"]">
        </div>

        <!-- Category Dropdown -->
        <div class="form-group mr-3">
            <label for="category" class="mr-2">Category:</label>
            <select class="form-control" id="category" name="category">
                <option value="">All Categories</option>
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Name" selected="@(Context.Request.Query["category"] == category.Name ? "selected" : null)">@category.Name</option>
                }
            </select>
        </div>

        <!-- Sort By Dropdown -->
        <div class="form-group mr-3">
            <label for="sortBy" class="mr-2">Sort By:</label>
            <select class="form-control" id="sortBy" name="sortBy">
                <option value="">Default</option>
                <option value="name_asc" selected="@(Context.Request.Query["sortBy"] == "name_asc" ? "selected" : null)">Name (A-Z)</option>
                <option value="name_desc" selected="@(Context.Request.Query["sortBy"] == "name_desc" ? "selected" : null)">Name (Z-A)</option>
                <option value="price_asc" selected="@(Context.Request.Query["sortBy"] == "price_asc" ? "selected" : null)">Price (Low to High)</option>
                <option value="price_desc" selected="@(Context.Request.Query["sortBy"] == "price_desc" ? "selected" : null)">Price (High to Low)</option>
            </select>
        </div>

        <!-- Low Stock Checkbox -->
        <div class="form-group mr-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="lowStockFilter" name="lowStockFilter" value="true" @(Context.Request.Query["lowStockFilter"] == "true" ? "checked" : "")>
                <label class="form-check-label" for="lowStockFilter">Show Low Stock Only</label>
            </div>
        </div>

        <!-- Apply Filters Button -->
        <button type="submit" class="btn btn-primary">Apply Filters</button>
        <a asp-action="Index" class="btn btn-secondary ml-2">Clear Filters</a>
    </form>
</div>

<!-- Product Table -->
<div class="container">
    <h3>Featured Products</h3>
    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Stock Status</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @if (Model != null) // Check if Model is null
        {
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Category</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>@product.Quantity</td>
                    <td>
                        @if (product.Quantity < product.LowStockThreshold)
                        {
                            <span class="badge badge-danger" style="background-color: #dc3545; color: white;">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge badge-success" style="background-color: #28a745; color: white;">In Stock</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-primary btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No products available.</td>
            </tr>
        }
        </tbody>
    </table>
</div>