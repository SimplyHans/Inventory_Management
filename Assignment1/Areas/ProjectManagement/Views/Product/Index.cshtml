@model IEnumerable<Assignment1.Areas.ProjectManagement.Models.Product>

@{
    ViewData["Title"] = "Inventory Management";
}

<h2>@ViewData["Title"]</h2>

<!-- Add New Product Button -->
<a asp-action="Create" class="btn btn-success mb-3">Create Product</a>

<a asp-controller="Category" asp-action="Index" class="btn btn-success mb-3">Add New Category</a>

<!-- Filters Section -->
<div class="container mb-4">
    <form method="get" asp-action="Index" class="form-inline">
        <!-- Search by Name -->
        <div class="form-group mr-3">
            <label for="searchQuery" class="mr-2">Search:</label>
            <input type="text" class="form-control" id="searchQuery" name="searchQuery" placeholder="Product name..." value="@Context.Request.Query["searchQuery"]">
        </div>

        <!-- Category Dropdown -->
        <div class="form-group mr-3">
            <label for="category" class="mr-2">Category:</label>
            <select class="form-control" id="category" name="category">
                <option value="">All Categories</option>
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Name" selected="@(Context.Request.Query["category"] == category.Name ? "selected" : null)">@category.Name</option>
                }
            </select>
        </div>

        <!-- Sort By Dropdown -->
        <div class="form-group mr-3">
            <label for="sortBy" class="mr-2">Sort By:</label>
            <select class="form-control" id="sortBy" name="sortBy">
                <option value="">Default</option>
                <option value="name_asc" selected="@(Context.Request.Query["sortBy"] == "name_asc" ? "selected" : null)">Name (A-Z)</option>
                <option value="name_desc" selected="@(Context.Request.Query["sortBy"] == "name_desc" ? "selected" : null)">Name (Z-A)</option>
                <option value="price_asc" selected="@(Context.Request.Query["sortBy"] == "price_asc" ? "selected" : null)">Price (Low to High)</option>
                <option value="price_desc" selected="@(Context.Request.Query["sortBy"] == "price_desc" ? "selected" : null)">Price (High to Low)</option>
            </select>
        </div>

        <!-- Low Stock Checkbox -->
        <div class="form-group mr-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="lowStockFilter" name="lowStockFilter" value="true" @(Context.Request.Query["lowStockFilter"] == "true" ? "checked" : "")>
                <label class="form-check-label" for="lowStockFilter">Show Low Stock Only</label>
            </div>
        </div>

        <!-- Apply Filters Button -->
        <button type="submit" class="btn btn-primary">Apply Filters</button>
        <a asp-action="Index" class="btn btn-secondary ml-2">Clear Filters</a>
    </form>
</div>

<!-- Product Table -->
<div class="container">
    <h3>Featured Products</h3>
    <div id="loadingScreen" style="display:none; margin-top: 20px; text-align: center;">
        <div class="spinner-border text-primary" role="status"/>
    </div>
    <table id="productTable" class="table table-bordered table-striped">
        <thead class="thead-dark">
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Stock Status</th>
            <th>Actions</th>
        </tr>
        </thead>
        

        <tbody id="productTableBody">
        @await Html.PartialAsync("_ProductTablePartial", Model)
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // Hide the loading screen initially
        $(document).ready(function () {
            $("#loadingScreen").hide();
        });

        // Function to load products via AJAX
        function loadProducts() {
            // Show the loading spinner when AJAX request starts
            $("#loadingScreen").show();

            // Hide the product table while loading
            $("#productTable").hide();

            let query = $("#searchQuery").val();
            let category = $("#category").val();
            let sortBy = $("#sortBy").val();
            let lowStockFilter = $("#lowStockFilter").is(":checked");

            // Perform the AJAX request
            $.ajax({
                url: '@Url.Action("Search", "Product", new { area = "ProjectManagement" })',
                data: {
                    searchQuery: query,
                    category: category,
                    sortBy: sortBy,
                    lowStockFilter: lowStockFilter
                },
                type: "GET", // Ensure the request is GET
                success: function (result) {
                    // Introduce a delay (e.g., 1 second) before hiding the loading screen and showing the data
                    setTimeout(function() {
                        // Hide the loading spinner after the data is loaded
                        $("#loadingScreen").hide();

                        // Update the product table with the new data
                        $("#productTableBody").html(result);

                        // Show the table once the data has been updated
                        $("#productTable").show();
                    }, 200);
                },
                error: function () {
                    // Hide the loading spinner if there's an error
                    $("#loadingScreen").hide();
                    alert("An error occurred while loading the data.");
                }
            });
        }

        // Trigger the loadProducts function only when the search query or filters change
        $(document).ready(function () {
            // Trigger AJAX when any search/filter input changes
            $("#searchQuery, #category, #sortBy, #lowStockFilter").on("change keyup", function () {
                loadProducts();
            });

            // Optional: Trigger search when pressing "Enter" in the search box
            $("#searchQuery").on("keypress", function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    loadProducts();
                }
            });
        });
    </script>
}



