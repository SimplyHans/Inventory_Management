@model IEnumerable<Assignment1.Areas.ProjectManagement.Models.Product>

@{
    ViewData["Title"] = "Inventory Management";
}

<style>
    .product-index-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
        align-items: flex-end;
    }

    .filter-row .form-group {
        flex: 1;
        min-width: 200px;
    }

    .form-control, .btn {
        border-radius: 0.75rem;
    }

    .form-check-input {
        border-radius: 50% !important;
        width: 2.25rem;
        height: 2.25rem;
        margin-top: 0.15rem;
        margin-right: 0.5rem;
        border: 1px solid #ccc;
    }
    

    .btn-success {
        margin-right: 1rem;
    }

    .table {
        border-radius: 1rem;
        overflow: hidden;
    }

    h2 {
        text-align: center;
    }
</style>

<div class="product-index-container">
    <h2 class="mb-2 fw-semibold text-start">@ViewData["Title"]</h2>


    <div class="d-flex mb-3">
        <a asp-action="Create" class="btn btn-success">Create Product</a>
        <a asp-controller="Category" asp-action="Index" class="btn btn-success">Add New Category</a>
    </div>

    <form method="get" asp-action="Index" class="filter-row">
        <!-- Search -->
        <div class="form-group">
            <label for="searchQuery">Search:</label>
            <input type="text" class="form-control" id="searchQuery" name="searchQuery" placeholder="Product name..." value="@Context.Request.Query["searchQuery"]">
        </div>

        <!-- Category -->
        <div class="form-group">
            <label for="category">Category:</label>
            <select class="form-control" id="category" name="category">
                <option value="">All Categories</option>
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Name" selected="@(Context.Request.Query["category"] == category.Name ? "selected" : null)">@category.Name</option>
                }
            </select>
        </div>

        <!-- Sort By -->
        <div class="form-group">
            <label for="sortBy">Sort By:</label>
            <select class="form-control" id="sortBy" name="sortBy">
                <option value="">Default</option>
                <option value="name_asc" selected="@(Context.Request.Query["sortBy"] == "name_asc" ? "selected" : null)">Name (A-Z)</option>
                <option value="name_desc" selected="@(Context.Request.Query["sortBy"] == "name_desc" ? "selected" : null)">Name (Z-A)</option>
                <option value="price_asc" selected="@(Context.Request.Query["sortBy"] == "price_asc" ? "selected" : null)">Price (Low to High)</option>
                <option value="price_desc" selected="@(Context.Request.Query["sortBy"] == "price_desc" ? "selected" : null)">Price (High to Low)</option>
            </select>
        </div>

        <!-- Low Stock Checkbox -->
        <div class="form-group d-flex align-items-end">
            <label class="d-flex align-items-center">
                <input class="form-check-input" type="checkbox" id="lowStockFilter" name="lowStockFilter" value="true" @(Context.Request.Query["lowStockFilter"] == "true" ? "checked" : "")>
                <span class="ml-2">Show Low Stock Only</span>
            </label>
        </div>
    </form>
</div>


<!-- Error Message Display -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Product Table -->
<div class="container">
    <div id="loadingScreen" style="display:none; margin: 2rem 0; text-align: center;">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
    <div class="table-responsive">
        <table id="productTable" class="table table-bordered table-striped">
            <thead class="thead-dark">
            <tr class="bg-primary text-white">
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Stock Status</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody id="productTableBody">
                @await Html.PartialAsync("_ProductTablePartial", Model)
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Hide the loading screen initially
        $(document).ready(function () {
            $("#loadingScreen").hide();
        });

        // Function to load products via AJAX
        function loadProducts() {
            // Show the loading spinner when AJAX request starts
            $("#loadingScreen").show();
            $("#productTable").parent().hide();

            let query = $("#searchQuery").val();
            let category = $("#category").val();
            let sortBy = $("#sortBy").val();
            let lowStockFilter = $("#lowStockFilter").is(":checked");

            // Perform the AJAX request
            $.ajax({
                url: '@Url.Action("Search", "Product", new { area = "ProjectManagement" })',
                data: {
                    searchQuery: query,
                    category: category,
                    sortBy: sortBy,
                    lowStockFilter: lowStockFilter
                },
                type: "GET",
                success: function (result) {
                    setTimeout(function() {
                        $("#loadingScreen").hide();
                        $("#productTableBody").html(result);
                        $("#productTable").parent().show();
                    }, 200);
                },
                error: function () {
                    $("#loadingScreen").hide();
                    $("#productTable").parent().show();
                    alert("An error occurred while loading the data.");
                }
            });
        }

        // Trigger the loadProducts function only when the search query or filters change
        $(document).ready(function () {
            // Trigger AJAX when any search/filter input changes
            $("#searchQuery, #category, #sortBy, #lowStockFilter").on("change keyup", function () {
                loadProducts();
            });

            // Optional: Trigger search when pressing "Enter" in the search box
            $("#searchQuery").on("keypress", function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    loadProducts();
                }
            });
        });
    </script>
}



