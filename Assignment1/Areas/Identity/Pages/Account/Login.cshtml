@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
<style>
    .center-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        margin-top: 7rem;
    }

    .login-container {
        width: 100%;
        max-width: 500px;
        padding: 1rem;
    }

    .form-control, .btn {
        border-radius: 0.75rem;
    }

    .form-check-input {
        border-radius: 0.35rem;
    }

    h1, h2 {
        text-align: center;
    }
</style>

<div class="center-wrapper">
    <h1>Welcome back!</h1>
    <h2 style="font-size: 20px;">
        <span style="color: #515151;">Don't have an account?</span>
        <a asp-page="./Register" class="text-decoration-none" asp-route-returnUrl="@Model.ReturnUrl">Register</a>
    </h2>

    <div class="login-container">
        <section>
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="form-check-label">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div class="d-grid mb-3">
                    <button id="login-submit" type="submit" class="btn btn-lg" style="background-color: #01e18e; color: white; font-weight: bold;">Log in</button>
                </div>
                
                <div class="text-center">
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                    </p>
                    <p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
